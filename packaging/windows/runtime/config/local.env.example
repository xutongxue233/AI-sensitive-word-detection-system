# Copy this file to local.env and edit values when needed.
# start.bat loads config/local.env before starting services.

# Web/backend port. Open http://127.0.0.1:8090/ after start.
SERVER_PORT=8090

# Python microservice ports.
ASR_PORT=9000
OCR_SERVICE_PORT=9001

# CPU defaults are safest for an unzip-and-run package.
# For NVIDIA GPU, set WHISPER_DEVICE=cuda, WHISPER_FP16=true, PADDLE_OCR_USE_GPU=true
# and make sure the bundled venvs were built with matching CUDA wheels.
WHISPER_DEVICE=cpu
WHISPER_FP16=false
PADDLE_OCR_USE_GPU=false

# Whisper model. tiny/base/small are lighter; large-v3-turbo is more accurate but heavy.
WHISPER_MODEL=large-v3-turbo

# OCR noise filters.
PADDLE_OCR_MIN_TEXT_LENGTH=2
PADDLE_OCR_DROP_SHORT_LATIN=true
PADDLE_OCR_MIN_REPEAT_FRAMES=2
