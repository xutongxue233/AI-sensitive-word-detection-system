# Local source startup defaults. Copy to config/local.env to override.

SERVER_PORT=8090
ASR_PORT=9000
OCR_SERVICE_PORT=9001

# ASR:faster-whisper(CTranslate2)纯 CPU、INT8 量化;medium 兼顾准确与速度,
# 求快可改 small,求更准可改 large-v3。
WHISPER_DEVICE=cpu
WHISPER_FP16=false
WHISPER_MODEL=medium
WHISPER_COMPUTE_TYPE=int8
# 可选:推理线程数,建议设为 CPU 物理性能核数(默认 auto=4 偏保守;开满全部核反而可能更慢):
# WHISPER_CPU_THREADS=8
# 无代理/离线部署可直接指向已复制的 faster-whisper CT2 模型目录；该目录优先于 WHISPER_MODEL。
# WHISPER_MODEL_PATH=D:\path\to\repo\.runtime\models\faster-whisper\medium
# 模型下载缓存和离线开关。WHISPER_PRELOAD=true 会在 setup 或服务启动时提前加载模型，
# 也可运行 `start-local.bat download-model` 单独预下载/校验模型。
# WHISPER_DOWNLOAD_ROOT=D:\path\to\repo\.runtime\models\faster-whisper
# WHISPER_LOCAL_FILES_ONLY=false
# WHISPER_PRELOAD=false
# 模型从 HuggingFace 下载;若直连失败可尝试镜像(注意:hf-mirror 对部分模型会
# 308 跳回源站导致 huggingface_hub 报错,届时应去掉本行改为直连/代理):
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_OFFLINE=false       # true 时禁止 HuggingFace 联网，仅使用已有缓存/模型目录

# pip 安装镜像、缓存与重试。无代理电脑可将 PIP_NO_INDEX=true 并配置本地 wheelhouse。
# PIP_INDEX_URL=https://pypi.org/simple
# PIP_EXTRA_INDEX_URL=
# PIP_FIND_LINKS=D:\path\to\repo\.runtime\wheels
# PIP_NO_INDEX=false
# PIP_CACHE_DIR=D:\path\to\repo\.runtime\pip-cache
# PIP_TIMEOUT=120
# PIP_RETRIES=4
# PIP_TRUSTED_HOST=

# 在线 ASR(引擎/端点/密钥/模型在前端齿轮设置里配,按任务即时生效;以下仅微调切片与上送行为):
# ASR_ONLINE_MAX_SPEECH_SECONDS=28   # 单片语音上限秒数,越短伪词时间戳越准但调用次数越多
# ASR_ONLINE_MIN_SILENCE_MS=500      # 静音超过该毫秒数即切片
# ASR_ONLINE_SPEECH_PAD_MS=150       # 片段首尾语音垫片毫秒数
# ASR_ONLINE_CONCURRENCY=2           # 并发上送片段数(在线服务普遍限流,调高易撞 429)
# ASR_ONLINE_TIMEOUT_SECONDS=120     # 单片识别请求超时秒数
# ASR_ONLINE_MAX_RETRIES=5           # 429/5xx/网络抖动的最大重试次数(指数退避,尊重 Retry-After)
# ASR_ONLINE_RETRY_BASE_SECONDS=1.5  # 退避基数秒,第 n 次重试约等待 base*2^n
# ASR_ONLINE_RETRY_MAX_WAIT_SECONDS=30  # 单次退避等待上限秒数

# 可选:后端构建/运行的 JDK 21 路径(默认 JAVA_HOME 非 21 时必配):
# JAVA_HOME=D:\path\to\jdk-21

# 导出重编码硬件编码器:auto 按 AMF(AMD)→QSV(Intel)→NVENC(NVIDIA) 试编码探测,
# 核显即可;全不可用自动回退 CPU libx264,只影响导出速度、不影响成败。
# FFMPEG_HW_ENCODER=auto             # auto|amf|qsv|nvenc|off
# FFMPEG_THREADS=2                   # 每个 FFmpeg 进程线程上限，低配可设 1

# 后端低配并发：默认一次处理一个视频，音频/OCR 两腿各占一个线程。
# APP_PIPELINE_TRANSCRIPT_CONCURRENCY=2
# APP_PIPELINE_MAX_CONCURRENT_JOBS=1
# AI_EXTRACTION_CONCURRENCY=1
# APP_SUBTITLE_OCR_INTERVAL_SECONDS=1.5
# APP_SUBTITLE_OCR_CROP_BOTTOM_RATIO=0.35
# APP_SUBTITLE_OCR_MIN_CONFIDENCE=0.65

# OCR:rapidocr-onnxruntime,模型随包自带、免下载。
# 默认使用 CPU onnxruntime；只有明确设置 OCR_USE_DML=1/true 才安装 DirectML。
# OCR_USE_DML=0                     # 0|1（DirectML 为显式可选）
# OCR_HW_DECODE=true                 # OCR 抽帧解码尝试 D3D11 硬解,失败自动回退软解
# 低配默认顺序解码、每1.5秒抽一帧、只扫描底部35%；质量模式可调小间隔或扫描整屏。
# OCR_MAX_WIDTH=1280                 # 2K/4K帧先缩小到此宽度，0=不限制
# OCR_UPSCALE=false                  # 小视频是否放大后识别，低配建议 false
PADDLE_OCR_USE_GPU=false
PADDLE_OCR_MIN_TEXT_LENGTH=2
PADDLE_OCR_DROP_SHORT_LATIN=true
PADDLE_OCR_MIN_REPEAT_FRAMES=2
